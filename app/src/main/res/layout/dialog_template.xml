<?xml version="1.0" encoding="utf-8"?>
<!-- Vorlagendialog: Titel, Gruppenzeilen (im Code gefüllt), Checkbox "Für alle Seiten", Knöpfe Abbrechen/Bestätigen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/templateTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/tpl_title"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black" />

    <LinearLayout
        android:id="@+id/templateGroups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <CheckBox
        android:id="@+id/templateAllPages"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@null"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/tpl_all_pages"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/templateCancel"
            style="@style/Widget.PaperNotes.DialogButton"
            android:text="@string/cancel" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/black" />

        <TextView
            android:id="@+id/templateConfirm"
            style="@style/Widget.PaperNotes.DialogButton"
            android:text="@string/tpl_confirm" />
    </LinearLayout>
</LinearLayout>
