<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile der Symbol-Legende in den Sync-Einstellungen: Logo mit Kurztext wie auf der Startseite, daneben die Bedeutung. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/legendSymbol"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nextcloud"
            android:tint="@color/icon_tint" />

        <TextView
            android:id="@+id/legendBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/legendText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:textSize="16sp" />
</LinearLayout>
