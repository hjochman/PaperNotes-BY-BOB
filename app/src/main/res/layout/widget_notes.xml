<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Notizen" (RemoteViews): nur erlaubte Views (LinearLayout, FrameLayout, TextView, ImageView, ImageButton, TextClock).
  Kopfzeile (48dp): optional Uhr (TextClock, ohne Sekunden), Titel "PaperNotes", Knopf "+"; darunter feste Zeilen 1..8
  (je 48dp, einzeilig), Leermeldung, optional Fußzeile "Alle Notizen". Schwarz auf Weiß, Linien statt Schatten.
  Die Ids sind die Schnittstelle zu WidgetRenderer; Maße (48dp) stehen auch in WidgetLogic.
  Rahmen: widgetRoot trägt den runden Rahmen mit transparentem Außenrand @dimen/widget_inset (bg_widget_framed; der Launcher
  clippt das Widget auf eine abgerundete Form); das Padding (widget_frame_padding) = Rand + 2dp Strich. Optional Sync/Batterie/Glocke stehen immer in der Kopfzeile (widgetStatusHdr), nie in einer
  eigenen Zeile. Reihenfolge von links: Uhr, Titel (weight=1, einzeilig, entfällt als Erstes bei Platzmangel), Sync, Batterie+Glocke, "+".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_framed"
    android:orientation="vertical"
    android:padding="@dimen/widget_frame_padding">

    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="0dp">

        <LinearLayout
            android:id="@+id/widgetClockBox"
