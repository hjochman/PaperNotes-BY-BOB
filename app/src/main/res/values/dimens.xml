<resources>
    <!-- Feste Höhen: flache Kopf-/Werkzeugzeile (Blatt soll groß bleiben); Unterleiste liegt als Popup über dem Blatt. -->
    <dimen name="editor_header_height">48dp</dimen>
    <dimen name="editor_toolbar_height">40dp</dimen>
    <dimen name="editor_subbar_height">56dp</dimen>

    <!-- Widget-Rahmen: inkOS clippt das Widget auf RoundedCornerShape(12dp). Der Rahmen liegt deshalb mit widget_inset Abstand
         innen (eine scharfe Ecke braucht >= 3,5dp, 4dp lässt Luft); widget_frame_padding = widget_inset + 2dp Strich und hat selbst abgerundete Ecken (widget_corner = Außenradius).
         widget_corner_inner = widget_corner minus 2dp Strich: Radius für Hintergründe der untersten Zeile. -->
    <dimen name="widget_inset">4dp</dimen>
    <dimen name="widget_frame_padding">6dp</dimen>
    <dimen name="widget_corner">12dp</dimen>
    <dimen name="widget_corner_inner">10dp</dimen>
</resources>
